{
  "compilerOptions": {
    // ── Entorno de compilación ───────────────────────────────────
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // ── Rutas de entrada / salida ────────────────────────────────
    "rootDir": "./src",
    "outDir": "./dist",

    // ── Outputs adicionales ──────────────────────────────────────
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // ── Tipado estricto ──────────────────────────────────────────
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // ── Misceláneo ───────────────────────────────────────────────
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
